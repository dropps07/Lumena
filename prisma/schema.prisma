generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Gradient {
  id        String   @id @default(uuid())
  slug      String   @unique
  config    Json
  createdAt DateTime @default(now()) @map("created_at")
  viewCount Int      @default(0) @map("view_count")

  @@map("gradients")
}